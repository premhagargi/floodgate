{
  "name": "floodgate-express",
  "version": "0.1.1",
  "description": "Express middleware for FloodGate rate limiter",
  "license": "MIT",
  "keywords": ["rate-limit", "rate-limiting", "express", "middleware", "redis", "floodgate", "throttle", "api"],
  "homepage": "https://github.com/premhagargi/floodgate#readme",
  "repository": { "type": "git", "url": "https://github.com/premhagargi/floodgate.git" },
  "engines": { "node": ">=20" },
  "files": ["dist"],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "express": ">=4.0.0",
    "floodgate-rl": "*"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "express": "^4.18.0",
    "floodgate-rl": "*",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  }
}
